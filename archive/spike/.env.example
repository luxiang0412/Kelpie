# 复制为 spike/.env 后填写；此文件不要提交，也不要放进截图/日志
# 必须是隔离的、可归零的主机；禁止使用团队生产机
export SPIKE_HOST=dev.example.com
export SPIKE_USER=me
export SPIKE_PORT=22
# 专门为 Spike 生成的密钥，不要用个人主密钥
export SPIKE_KEY=~/.ssh/id_ed25519_spike
# 用户带外核对后提供的指纹（ssh-keyscan -t ed25519 $SPIKE_HOST | ssh-keygen -lf -）
export SPIKE_HOST_KEY_SHA256=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 专用 herdr 会话；不要用团队正在用的会话名
export HERDR_SESSION=spike
# 主机上 herdr 的绝对路径（非交互 shell 的 PATH 可能不同）
export SPIKE_HERDR_BIN=/home/me/.local/bin/herdr
# 主机上的一次性测试仓库
export SPIKE_REPO=~/spike-sandbox
# App 侧主机标识（本地信任库 key）
export SPIKE_HOST_ID=spike-1
